password_hash = PasswordHash.recommended () # employs Argon2 hashing algo


def create_token (username : str , duration_minutes  = settings.minutes_to_expiry  ) : 
	exp = datetime.now( timezone.utc ) + timedelta (minutes=duration_minutes  )   
	_token = jwt.encode ( { "user_name" : username , "exp" : exp }, settings.secret_key, algorithm= settings.algorithm )  
	token= Token ( token = _token, token_type = "bearer" ) 
	return token

async def create_user ( session : AsyncSession ,username : str , password : str ) -> User :
	hashed_password	= await run_in_threadpool( password_hash.hash , password )
	new_user = User.model_validate ( { "user_name": username, "hashed_password" : hashed_password }) 
	#breakpoint() 
	stmt = pg_insert ( User ).values (  user_name =  username, hashed_password = hashed_password).on_conflict_do_nothing().returning ( User ) 
	result = await session.execute ( stmt ) 
	session.commit()
	user = result.scalar_one_or_none() 
	if not user : 
		raise HTTPException ( status_code=401 , detail = "username alreay exists")
	return user    


async def get_user ( session : AsyncSession , username : str ) -> Optional[UserRead, None]  : 
	stmt = select ( User ).where ( User.user_name == username )
	result = await session.execute ( stmt ) 
	user = result.scalar_one_or_none() 
	if user.disabled : 
		raise HTTPException ( status_code=status.HTTP_401_UNAUTHORIZED_ERROR, detail="User no longer exists" )# need different http code 
	return user
		

async def authenticate_user  (session : AsyncSession ,username : str, password ) -> UserRead : 
	user = get_user( session , username  ) 
	pwd_match, hashed_password = run_in_threadpool ( password_hash.verify, password, user.hashed_password ) 
	if  not ( user and pwd_match ) : 
		raise HTTPException ( status_code=status.HTTP_401_UNAUTHORIZED_ERROR , detail = "username or password incorrect" ) 
	return { "username" : user.user_name, "created_at" : user.created_at } 

async def get_current_user ( session : AsyncSession , token : oauth2_scheme   ) -> UserRead: 
	
	try:
		token_payload = jwt.decode( token, settings.security_key, algorithms=[settings.algorithm ] ) 
	except InvalidTokenError: 
		raise HTTPException ( status_code = status.HTTP_401_UNAUTHORIZED_ERROR, detail= " bad token: expired or wrong signature" , headers= { "WWW-Authenticate" : "Bearer" } )

	user = get_user ( token_payload.get("user_name" ) ) 
	return { "user_name" : user.user_name, "created_at" : user.created_at } 
 
app=FastAPI( root="/socialmedial/api/v1/", lifespan=_lifespan ) 

@app.put("/register/"  ) 
async def register ( session : SessionDep, form : Annotated [ OAuth2PasswordRequestForm , Depends() ]     ) :
	new_user = await create_user ( session ,form.username, form.password )
	return new_user

@app.put( "/login/", response_model=UserRead )
async def login ( session: SessionDep, user : UserIn )-> UserRead :
	authed_user = await authenticate_user( session ,user.user_name, user.password.get_secret_value()  ) 
	token = await create_token ( authed_user.user_name  )  
	return authed_user


